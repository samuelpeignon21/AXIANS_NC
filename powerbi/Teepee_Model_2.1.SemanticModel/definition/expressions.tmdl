expression 'TAB_Demande_d''assistance_(tickets)_TSF' =
		let
		    Source = #"TAB_Demande_d'assistance_(tickets)",
		    #"Colonnes permutées" = Table.ReorderColumns(Source,{"DemandeDAssistanceV2_ID", "ManuelOUAutomatique", "NumeRoDeTicket", "Objet", "ConcateNationObjet", "EMailDuDemandeur", "EmailCC", "Demande", "ReCapitulatifDeLaDemande", "Description", "DernieReJustificationDeMiseEnAttente", "StatutDuTicket", "Type", "Type_1", "DateDeCreAtion_1", "TestTimeZone", "DateDeCreAtion", "DatePassageAuStatutEnCours", "DatePassageAuStatutReSolu", "DatePassageAuStatutFacture", "NombreDHeureFacturables", "TOTALHT", "TOTALTGC", "TOTALAFACTURER"}),
		    #"Colonnes renommées" = Table.RenameColumns(#"Colonnes permutées",{{"ManuelOUAutomatique", "Manuel ou automatique"}, {"NumeRoDeTicket", "Numéro de ticket"}, {"Objet", "Objet / Intitulé"}, {"ConcateNationObjet", "Ticket"}, {"EMailDuDemandeur", "Email Demandeur"}, {"EmailCC", "Email CC"}, {"Demande", "Demande Auto"}, {"ReCapitulatifDeLaDemande", "Demande Manu"}, {"Description", "Description Coordinateur"}, {"DernieReJustificationDeMiseEnAttente", "Dernière justification de mise en attente"}, {"StatutDuTicket", "Statut"}, {"Type", "Catégorie"}, {"Type_1", "Type"}, {"DateDeCreAtion", "Date de création"}, {"DatePassageAuStatutEnCours", "Date passage au statut prise en compte"}, {"DatePassageAuStatutReSolu", "Date passage au statut résolu"}, {"DatePassageAuStatutFacture", "Date passage au statut facturé"}, {"NombreDHeureFacturables", "Nombre heures facturables"}, {"TOTALAFACTURER", "Total TTC"}, {"TOTALHT", "Total HT"}, {"TOTALTGC", "Total TGC"}, {"DateDeCreAtion_1", "Date de création M"}, {"TestTimeZone", "Date de création A"}, {"NotificationsDeSactiveS", "Notifications désactivées"}}),
		    #"Lignes triées / numéro de ticket desc" = Table.Sort(#"Colonnes renommées",{{"Numéro de ticket", Order.Descending}}),
		    #"Trsf col - Manu OU Auto" = Table.TransformColumns(
		    #"Lignes triées / numéro de ticket desc",
		    {{"Manuel ou automatique",
		        each if _ = 1 then "Automatique"
		        else if _ = 0 then "Manuel"
		        else null,
		        type text
		    }}
		),
		    #"Philtre ""Vide"" - col Manu ou auto" = Table.SelectRows(#"Trsf col - Manu OU Auto", each ([Manuel ou automatique] <> null)),
		    #"Trsf col - Statut" = Table.TransformColumns(
		    #"Philtre ""Vide"" - col Manu ou auto",
		    {{"Statut",
		        each if _ = "Nouveau" then "Nouveau"
		        else if _ = "InterventionProgramme" then "Intervention Programmée"
		        else if _ = "ReSolu" then "Résolu"
		        else if _ = "EnCours" then "Prise en compte"
		        else if _ = "EnAttente" then "En attente"
		        else if _ = "Annule" then "Annulé"
		        else if _ = "AFacture" then "A Facturé"
		        else if _ = "Facture" then "Facturé"
		        else null,
		        type text
		    }}
		),
		    #"New Col - Demande" = Table.AddColumn(#"Trsf col - Statut", "Demande", each if [Manuel ou automatique] = "Manuel" then [Demande Manu] else if [Manuel ou automatique] = "Automatique" then [Demande Auto] else null),
		    #"Colonnes ""Demande"" Permuté" = Table.ReorderColumns(#"New Col - Demande",{"DemandeDAssistanceV2_ID", "Manuel ou automatique", "Numéro de ticket", "Objet / Intitulé", "Ticket", "Email Demandeur", "Email CC", "Demande Auto", "Demande Manu", "Demande", "Description Coordinateur", "Dernière justification de mise en attente", "Statut", "Catégorie", "Type", "Date de création M", "Date de création", "Date passage au statut prise en compte", "Date passage au statut résolu", "Date passage au statut facturé", "Nombre heures facturables", "Total HT", "Total TGC", "Total TTC"}),
		    #"Type 'Demande' -> Texte" = Table.TransformColumnTypes(#"Colonnes ""Demande"" Permuté",{{"Demande", type text}}),
		    #"Trsf col - Catégorie" = Table.TransformColumns(
		    #"Type 'Demande' -> Texte",
		    {{"Catégorie",
		        each if _ = "NOUVELLEDEMANDE" then "NOUVELLE DEMANDE"
		        else if _ = "BUILD" then "BUILD"
		        else if _ = "RUN" then "RUN"
		        else if _ = "INFOGERANCE" then "INFOGERANCE"
		        else if _ = "BUSINESS" then "BUSINESS"
		        else if _ = "SERVICES" then "SERVICES"
		        else if _ = "CONGESFERIEMALADIE" then "CONGES / FERIE / MALADIE"
		        else null ,
		        type text
		    }}
		),
		    Jointure_Entreprise = Table.NestedJoin(#"Trsf col - Catégorie", {"DemandeDAssistanceV2_ID"}, REL_Entreprises_Tickets, {"DemandeDAssistanceV2_ID"}, "REL_Entreprises_Tickets", JoinKind.LeftOuter),
		    Expand_ID_Entreprise = Table.ExpandTableColumn(Jointure_Entreprise, "REL_Entreprises_Tickets", {"Entreprise_ID"}, {"REL_Entreprises_Tickets.Entreprise_ID"}),
		    Jointure_Sites = Table.NestedJoin(Expand_ID_Entreprise, {"DemandeDAssistanceV2_ID"}, REL_Sites_Concerné_Tickets, {"DemandeDAssistanceV2_ID"}, "REL_Sites_Concerné_Tickets", JoinKind.LeftOuter),
		    Expand_ID_Sites = Table.ExpandTableColumn(Jointure_Sites, "REL_Sites_Concerné_Tickets", {"Clients_ID"}, {"REL_Sites_Concerné_Tickets.Clients_ID"}),
		    Jointure_Priorité = Table.NestedJoin(Expand_ID_Sites, {"DemandeDAssistanceV2_ID"}, REL_Priorité_Tickets, {"DemandeDAssistanceV2_ID"}, "REL_Priorité_Tickets", JoinKind.LeftOuter),
		    Expand_Priorité = Table.ExpandTableColumn(Jointure_Priorité, "REL_Priorité_Tickets", {"TAB_Priorité.Priorite"}, {"REL_Priorité_Tickets.TAB_Priorité.Priorite"}),
		    #"Jointure Affaire" = Table.NestedJoin(Expand_Priorité, {"DemandeDAssistanceV2_ID"}, REL_Affaire_Tickets, {"DemandeDAssistanceV2_ID"}, "REL_Affaire_Tickets", JoinKind.LeftOuter),
		    Expand_Affaire = Table.ExpandTableColumn(#"Jointure Affaire", "REL_Affaire_Tickets", {"TEEPEE_AffairesCodex_ID"}, {"REL_Affaire_Tickets.TEEPEE_AffairesCodex_ID"}),
		    #"Duplication - Date de création" = Table.DuplicateColumn(Expand_Affaire, "Date de création", "Date de création - Copier"),
		    #"Type - Date de création - Date" = Table.TransformColumnTypes(#"Duplication - Date de création",{{"Date de création - Copier", type date}}),
		    #"Trsf col - Priorité" = Table.TransformColumns(
		    #"Type - Date de création - Date",
		    {{"REL_Priorité_Tickets.TAB_Priorité.Priorite",
		        each if _ = "1 - Majeur 🔴" then "Majeur"
		        else if _ = "2 - Mineur 🟠" then "Mineur"
		        else if _ = "3 - Non urgent 🟢" then "Non urgent"
		        else null,
		        type text
		    }}
		),
		    Jointure_Contrats = Table.NestedJoin(#"Trsf col - Priorité", {"DemandeDAssistanceV2_ID"}, REL_Contrat_Tickets, {"DemandeDAssistanceV2_ID"}, "REL_Contrat_Tickets", JoinKind.LeftOuter),
		    Expand_ID_Contrat = Table.ExpandTableColumn(Jointure_Contrats, "REL_Contrat_Tickets", {"Contrats_ID"}, {"REL_Contrat_Tickets.Contrats_ID"})
		in
